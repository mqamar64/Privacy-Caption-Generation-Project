{
  "_about": "How each PPG data type is classified. Edit freely: the classification sub-team owns this table. 'level' follows Vong's three tiers (identifier = names one person on its own; quasi_identifier = identifies someone when combined with other data; sensitive_attribute = reveals something private about a person; other = not personal on its own). 'play' is the Google Play Data safety category, 'apple' the App Store privacy label category. Lookup order: data_types first, then categories.",

  "levels": {
    "identifier": "PII identifier: names one person on its own (like an SSN)",
    "quasi_identifier": "Quasi-identifier: identifies a person when combined (like zip code + DOB + gender)",
    "sensitive_attribute": "Sensitive attribute: private fact about a person (like religion, salary, grades)",
    "other": "Not personal on its own"
  },

